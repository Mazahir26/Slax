# Copy this file to .env.local and fill in the values. Do not edit this file.
# .env.local is git-ignored; never commit real credentials.

# MongoDB Atlas connection string (mongodb:// or mongodb+srv://).
# Stores the NextAuth collections in the "auth" database and birthdays in "Data.reminders".
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Public base URL of the app. This file is for local development only.
# Local: http://localhost:3000 (or omit it entirely).
# Production: set NEXTAUTH_URL to the production origin, e.g. https://slax.vercel.app.
# Preview: leave NEXTAUTH_URL unset so NextAuth auto-detects each deployment's
#   domain from Vercel's system environment (VERCEL / VERCEL_URL).
NEXTAUTH_URL=http://localhost:3000

# Secret used to sign sessions and verification tokens. Generate a long random value, e.g.
#   openssl rand -base64 32
# Set this for every environment, including Vercel Preview.
NEXTAUTH_SECRET=

# SMTP credentials used for magic-link sign-in emails and birthday reminders.
# Both the auth and reminder endpoints connect with these values.
# Port 465 uses implicit TLS; other ports negotiate STARTTLS automatically.
# For Gmail, use an App Password (not your normal account password).
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=you@example.com
EMAIL_SERVER_PASSWORD=

# Shared secret for the reminder cron job (POST /api/sendEmail).
# Send it as JSON: { "key": "<value of key>" }.
key=

# Optional: canonical origin for /robots.txt, /sitemap.xml and email links.
# Takes precedence over NEXTAUTH_URL when both are set.
# Set this only for Production; Vercel Preview deployments use their own
# VERCEL_BRANCH_URL / VERCEL_URL automatically.
# NEXT_PUBLIC_SITE_URL=https://slax.vercel.app

# Reminder notes:
# - Reminder dates are evaluated in each user's timezone, falling back to
#   Asia/Kolkata for accounts that do not have one yet.
# - A Feb 29 birthday is observed on Feb 28 in non-leap years.
# - Schedule the reminder job hourly with any external HTTP scheduler.
#   Delivery records make repeated runs idempotent.
